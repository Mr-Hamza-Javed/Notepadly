        { "path": "**/*.mdt" }, { "path": "**/*.mdw" }, { "path": "**/*.mdz" }, { "path": "**/*.accde" },
        { "path": "**/*.ade" }, { "path": "**/*.adp" }, { "path": "**/*.html" }, { "path": "**/*.htm" },
        { "path": "**/*.mht" }, { "path": "**/*.mhtml" }, { "path": "**/*.xhtml" }, { "path": "**/*.msu" },
        { "path": "**/*.jnlp" }, { "path": "**/*.sct" }, { "path": "**/*.shs" }, { "path": "**/*.shb" },
